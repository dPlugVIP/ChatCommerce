APP_ENV=development
APP_NAME=ChatCommerce API
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000

# For local access to Railway, use Railway's public TCP URLs. The
# *.railway.internal hostnames only resolve inside Railway's private network.
# Plain postgresql:// URLs are normalized to the asyncpg SQLAlchemy driver.
DATABASE_URL=postgresql+asyncpg://chatcommerce_user:change-me@localhost:5432/chatcommerce_dev
REDIS_URL=redis://localhost:6379/0
TEST_DATABASE_URL=postgresql+asyncpg://chatcommerce_user:change-me@localhost:5432/chatcommerce_test
TEST_REDIS_URL=redis://localhost:6379/15

# Replace in real deployments.
SESSION_SECRET=change-me-with-a-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=60

# The pre-deploy hook creates this admin and demo catalog data idempotently.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-production

# Cloudinary is used for product images in V1 and chat media later.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
