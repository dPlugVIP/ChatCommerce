APP_ENV=development
APP_NAME=ChatCommerce API
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000

# Railway Postgres / Redis URLs. Use isolated test resources for APP_ENV=test.
DATABASE_URL=postgresql+asyncpg://chatcommerce_user:change-me@localhost:5432/chatcommerce_dev
REDIS_URL=redis://localhost:6379/0
TEST_DATABASE_URL=postgresql+asyncpg://chatcommerce_user:change-me@localhost:5432/chatcommerce_test
TEST_REDIS_URL=redis://localhost:6379/15

# Replace in real deployments.
SESSION_SECRET=change-me-with-a-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=60

# Seeded admin for first setup only.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-production

# Cloudinary is used for product images in V1 and chat media later.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
